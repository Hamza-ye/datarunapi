<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- =============================================
         platform_entity_type + platform_entity
         ============================================= -->

    <changeSet id="platform-001-entity-type" author="platform">
        <createTable tableName="platform_entity_type">
            <column name="id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="code" type="varchar(100)">
                <constraints nullable="false"/>
            </column>
            <column name="structure" type="varchar(20)">
                <constraints nullable="false"/>
            </column>
            <column name="attribute_schema" type="jsonb"/>
        </createTable>

        <addUniqueConstraint
            tableName="platform_entity_type"
            columnNames="code"
            constraintName="uk_entity_type_code"/>
    </changeSet>

    <changeSet id="platform-001-entity" author="platform">
        <createTable tableName="platform_entity">
            <column name="id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="uid" type="varchar(64)">
                <constraints nullable="false"/>
            </column>
            <column name="code" type="varchar(100)"/>
            <column name="name" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="type_id" type="uuid">
                <constraints nullable="false"/>
            </column>
            <column name="attributes" type="jsonb"/>
            <column name="created_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addUniqueConstraint
            tableName="platform_entity"
            columnNames="uid"
            constraintName="uk_entity_uid"/>

        <addForeignKeyConstraint
            baseTableName="platform_entity"
            baseColumnNames="type_id"
            referencedTableName="platform_entity_type"
            referencedColumnNames="id"
            constraintName="fk_entity_type"/>

        <createIndex tableName="platform_entity" indexName="idx_entity_type_id">
            <column name="type_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
